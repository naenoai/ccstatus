{
  "name": "ccstatus",
  "displayName": "CC Status",
  "description": "Shows Claude Code context usage, model, git branch, rate limits, and session duration in the VS Code status bar.",
  "version": "1.1.0",
  "publisher": "naenoai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/naenoai/ccstatus.git"
  },
  "bugs": {
    "url": "https://github.com/naenoai/ccstatus/issues"
  },
  "homepage": "https://github.com/naenoai/ccstatus#readme",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1a0a2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "statusline",
    "status bar",
    "ai",
    "context window",
    "rate limit"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "CC Status",
      "properties": {
        "claudeStatusline.scriptPath": {
          "type": "string",
          "default": "",
          "description": "Path to statusline.sh script. Leave empty to auto-detect from ~/.claude/statusline.sh"
        },
        "claudeStatusline.refreshInterval": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 60,
          "description": "How often to refresh the status bar (seconds)"
        },
        "claudeStatusline.showModel": {
          "type": "boolean",
          "default": true,
          "description": "Show model display name"
        },
        "claudeStatusline.showContextBar": {
          "type": "boolean",
          "default": true,
          "description": "Show context window progress bar"
        },
        "claudeStatusline.contextWindowSize": {
          "type": "string",
          "default": "",
          "markdownDescription": "Context window size used as the denominator for the context percentage. Leave empty to detect it from the model. Accepts `200k`, `1M`, or a plain token count — set this for third-party APIs whose window size cannot be inferred from the model name."
        },
        "claudeStatusline.showGitBranch": {
          "type": "boolean",
          "default": true,
          "description": "Show git branch"
        },
        "claudeStatusline.showRateLimits": {
          "type": "boolean",
          "default": true,
          "description": "Show rate limit percentages"
        },
        "claudeStatusline.showSessionReset": {
          "type": "boolean",
          "default": true,
          "description": "Show time until the 5-hour session limit resets (requires Show Rate Limits)"
        },
        "claudeStatusline.showWeeklyReset": {
          "type": "boolean",
          "default": true,
          "description": "Show time until the weekly limit resets (requires Show Rate Limits)"
        },
        "claudeStatusline.showSessionDuration": {
          "type": "boolean",
          "default": true,
          "description": "Show how long the current session has been running"
        },
        "claudeStatusline.alignment": {
          "type": "string",
          "default": "left",
          "enum": [
            "left",
            "right"
          ],
          "description": "Status bar item alignment"
        },
        "claudeStatusline.priority": {
          "type": "number",
          "default": 100,
          "description": "Status bar item priority (higher = more left when left-aligned)"
        },
        "claudeStatusline.showSubscription": {
          "type": "boolean",
          "default": true,
          "description": "Show subscription plan and tier (Pro, Team, Max 5×, etc.)"
        }
      }
    },
    "commands": [
      {
        "command": "claudeStatusline.refresh",
        "title": "CC Status: Refresh Now"
      },
      {
        "command": "claudeStatusline.showDetails",
        "title": "CC Status: Show Details"
      },
      {
        "command": "claudeStatusline.openSettings",
        "title": "CC Status: Open Settings"
      },
      {
        "command": "claudeStatusline.diagnose",
        "title": "CC Status: Run Diagnostics"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p ./ --noEmit && tsc --noEmit --strict --module Node16 --target ES2020 --esModuleInterop --skipLibCheck src/*.test.ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vscode/vsce": "^2.32.0",
    "eslint": "^8.57.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
